<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 套件資料夾改放在專案資料夾內(<專案>\.cache\nuget\packages),不寫到 C:\Users。
  注意:nuget.config 只能改 globalPackagesFolder;HTTP 快取、外掛快取與暫存只能用環境變數改
  (NUGET_HTTP_CACHE_PATH、NUGET_PLUGINS_CACHE_PATH、NUGET_SCRATCH;Windows 預設在 %LOCALAPPDATA%\NuGet 與 %TEMP%,即 C:\)。
  這三個變數由 tools\setup-windows.ps1(使用者層級)與各建置/啟動腳本(程序層級)指到 .cache\nuget\{http,plugins,scratch}。
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".cache/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

; Simosa BRM 3D 視景客戶端(Godot 4.5 .NET;規劃書第 5.2 節 Visual、第 7.3 節品質分級、第 10.1 節 D7 Godot 零授權費方案)
; 只訂閱 SimCore.Host 的狀態流(ws://127.0.0.1:8765),不做物理。
; 使用者資料目錄:以自含模式(執行檔旁放 _sc_ 檔)或啟動腳本的 XDG_*/APPDATA 環境變數留在專案內(docs/design/visual-client.md 第 8 節)。
; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it's still useful to know the file format.
config_version=5

[application]

config/name="Simosa BRM Visual"
config/description="中塑海運 FS Bitumen BRM 操船模擬器 3D 視景客戶端(只顯示、不做物理)"
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SimosaBRM-Visual"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
run/low_processor_mode=false

[debug]

gdscript/warnings/enable=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="SimosaBRM.Visual.Godot"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

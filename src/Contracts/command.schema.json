{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simosa-brm/contracts/command.schema.json",
  "title": "SimCommand",
  "description": "各站送往模擬核心的指令(gRPC/WebSocket JSON)。情境引擎新增 triggerTimeline、acknowledge、endExercise、getAssessment(查詢:主控程序直接回覆 {\"type\":\"assessment\",\"final\",\"summary\"},不進引擎佇列、不寫 input 行);setEnvironment args 加 visibility_nm、ramp_s(漸變秒數);injectFault 可為 value 字串或 args {name, args}。WebSocket 另推送 {\"type\":\"event\",\"event\":SimEvent} 與 {\"type\":\"assessment\",…} 框。",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "rudder",
        "telegraph",
        "rpm",
        "thruster",
        "autopilot",
        "freeze",
        "resume",
        "reset",
        "timeScale",
        "loadScenario",
        "setEnvironment",
        "injectFault",
        "clearFault",
        "snapshot",
        "restore",
        "targetControl",
        "triggerTimeline",
        "acknowledge",
        "endExercise",
        "getAssessment"
      ]
    },
    "value": {},
    "args": {
      "type": "object",
      "description": "targetControl:id(add 除外)、add{目標船定義,同 scenario.schema.json targets[]}、remove、heading/speed(教官覆寫)、release、position{lat,lon|x,y}、waypoints[]、aisOn、aisError{…}|null、behaviour{…}、colreg(giveWay|standOn|auto|off)、lights、sound、activate;setEnvironment:wind{trueSpeed,trueDir,gustiness}、current{set,drift}、waterDepth、visibility_nm、ramp_s;injectFault:{name, args};triggerTimeline:{id, force};acknowledge:{kind: verbal|notifyEcr|callMaster|report|checklist|steeringMode|anchorReady|other, itemId?, role?, note?};endExercise:{reason?}"
    }
  },
  "examples": [
    {
      "type": "rudder",
      "value": -20
    },
    {
      "type": "telegraph",
      "value": "HAH"
    },
    {
      "type": "autopilot",
      "args": {
        "enabled": true,
        "heading": 275,
        "rotLimit": 15
      }
    },
    {
      "type": "setEnvironment",
      "args": {
        "wind": {
          "trueSpeed": 20,
          "trueDir": 40
        },
        "current": {
          "set": 265,
          "drift": 2.5
        },
        "waterDepth": 12
      }
    },
    {
      "type": "targetControl",
      "args": {
        "id": "T1",
        "heading": 250,
        "speed": 6
      }
    },
    {
      "type": "targetControl",
      "args": {
        "id": "T1",
        "aisOn": false
      }
    },
    {
      "type": "targetControl",
      "args": {
        "id": "T1",
        "aisError": {
          "positionOffset": 500,
          "positionOffsetBearing": 90,
          "headingError": 20
        }
      }
    },
    {
      "type": "targetControl",
      "args": {
        "id": "T1",
        "colreg": "giveWay",
        "sound": "oneShort"
      }
    },
    {
      "type": "targetControl",
      "args": {
        "id": "T1",
        "waypoints": [
          {
            "x": 2000,
            "y": 5000,
            "speed": 8
          },
          {
            "lat": 23.9,
            "lon": 120.1
          }
        ]
      }
    },
    {
      "type": "targetControl",
      "args": {
        "add": {
          "id": "T9",
          "shipType": "tug",
          "loa": 30,
          "beam": 10,
          "initial": {
            "position": {
              "x": 500,
              "y": 500
            },
            "heading": 90,
            "speed": 5
          },
          "behaviour": {
            "mode": "follow",
            "follow": {
              "leader": "own",
              "bearing": 180,
              "range": 150
            }
          }
        }
      }
    },
    {
      "type": "targetControl",
      "args": {
        "id": "T9",
        "remove": true
      }
    },
    {
      "type": "setEnvironment",
      "args": {
        "wind": {
          "trueSpeed": 20,
          "trueDir": 10
        },
        "visibility_nm": 2,
        "ramp_s": 180
      }
    },
    {
      "type": "injectFault",
      "args": {
        "name": "steeringGear",
        "args": {
          "jamAt_deg": 15
        }
      }
    },
    {
      "type": "triggerTimeline",
      "args": {
        "id": "emergencySteering",
        "force": false
      }
    },
    {
      "type": "acknowledge",
      "args": {
        "kind": "notifyEcr",
        "itemId": "steeringFail",
        "role": "master",
        "note": "已電話通知機控室"
      }
    },
    {
      "type": "endExercise",
      "args": {
        "reason": "到達泊位"
      }
    },
    {
      "type": "getAssessment"
    }
  ]
}

            "$ref": "#/$defs/triggerCondition"
          }
        },
        "not": {
          "$ref": "#/$defs/triggerCondition"
        },
        "atLeast": {
          "$ref": "#/$defs/numberOrParam"
        },
        "since": {
          "type": "object",
          "required": [
            "event"
          ],
          "properties": {
            "event": {
              "type": "string"
            },
            "itemId": {
              "type": "string"
            },
            "targetId": {
              "type": "string"
            },
            "legIndex": {
              "type": "integer"
            },
            "waypoint": {
              "type": "string"
            }
          }
        },
        "point": {
          "$ref": "#/$defs/position"
        },
        "waypoint": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "lessThan": {
          "$ref": "#/$defs/numberOrParam"
        },
        "greaterThan": {
          "$ref": "#/$defs/numberOrParam"
        },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simosa-brm/contracts/scenario.schema.json",
  "title": "Scenario",
  "description": "情境檔(data/scenarios/*.yaml;規劃書第 9.1 節、第 11.3 節;情境引擎設計 docs/design/scenario-engine.md)。最小 schema:自船 ID 與裝載狀態、初始位置(經緯度或本地 ENU)/航向/速度、環境、亂數種子;選填 targets(目標船)、assessment(評估門檻與規則)、timeline(事件時間表)、route(航線)、zones(區域)、briefing(簡報)。C# SimCore 與 Python 參考實作共用(Python 忽略 targets/assessment/timeline/route/zones);角度為度、速度為節、航向 0 至 360、風向為來向、流向為去向。數值欄位可寫整個字串 \"${params:<鍵>}\" 引用公司程序參數集(parameter-set.schema.json),載入時解析;在 YAML 流式寫法 { } 內須加引號。",
  "type": "object",
  "required": [
    "id",
    "ship",
    "initial",
    "environment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "情境代號(例如 E01_baseline),用於紀錄檔名"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "default": 1,
      "description": "亂數種子;所有亂數(陣風等)由 Random(seed) 產生"
    },
    "startTimeUtc": {
      "type": "string",
      "format": "date-time",
      "description": "練習開始的 UTC 時刻(供 NMEA 時間欄位);未指定時以實際時鐘代入"
    },
    "timeScale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10,
      "default": 1
    },
    "ship": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "FSB1",
            "FSB2"
          ]
        },
        "loading": {
          "type": "string",
          "enum": [
            "full",
            "ballast",
            "intermediate"
          ],
          "default": "ballast"
        }
      }
    },
    "origin": {
      "type": "object",
      "description": "本地 ENU 原點;未指定時以初始位置的經緯度為原點(初始位置用 x/y 時必填)",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "initial": {
      "type": "object",
      "required": [
        "position",
        "heading"
      ],
      "properties": {
        "position": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "lat",
                "lon"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            },
            {
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "description": "本地 ENU 東向 (m)"
                },
                "y": {
                  "type": "number",
                  "description": "本地 ENU 北向 (m)"
                }
              }
            }
          ]
        },
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "speed": {
          "type": "number",
          "default": 0,
          "description": "初始對水速度 (kn)"
        },
        "telegraph": {
          "type": "string",
          "enum": [
            "EFAS",
            "FAS",
            "HAS",
            "SAS",
            "DSAS",
            "STOP",
            "DSAH",
            "SAH",
            "HAH",
            "FAH",
            "NAVF"
          ],
          "description": "未指定時:MMG 模型取該航速的直航平衡轉速(以最接近的車令標示);暫代模型取航速最接近的前進車令"
        },
        "rpm": {
          "type": "number",
          "description": "初始軸轉速 (rpm,倒車負);指定時優先於車鐘/航速推得的轉速,轉速令同值"
        },
        "rudder": {
          "type": "number",
          "default": 0,
          "description": "初始舵角(度,右正)"
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "waterDepth"
      ],
      "properties": {
        "wind": {
          "type": "object",
          "properties": {
            "trueSpeed": {
              "type": "number",
              "minimum": 0,
              "description": "真風速 (kn)"
            },
            "trueDir": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "真風來向(度)"
            },
            "gustiness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0,
              "description": "陣風強度(每秒以種子亂數在 ±gustiness 內更新係數)"
            }
          }
        },
        "current": {
          "type": "object",
          "properties": {
            "set": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "description": "流向(去向,度)"
            },
            "drift": {
              "type": "number",
              "minimum": 0,
              "description": "流速 (kn)"
            }
          }
        },
        "waterDepth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "水深 (m,常數;日後改為水深網格參照)"
        },
        "visibility_nm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "能見度(nm;未給 = 無限制);核心只保存、漸變、廣播與記錄,無物理效果"
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "目標船(交通);Python 參考實作忽略",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "assessment": {
      "type": "object",
      "description": "評估參數與規則(規劃書第 8.3 節;情境引擎設計第 1.3 節);數值欄位可引用參數集",
      "properties": {
        "parameterSet": {
          "type": "string",
          "description": "參數集路徑(選填;預設 data/parameters/company-procedures.yaml,主控程序 --parameters 可覆寫)"
        },
        "minCpa_nm": {
          "$ref": "#/$defs/numberOrParam",
          "default": 0.5,
          "description": "自船與任一目標 CPA 低於此值且 TCPA > 0 時記錄 cpaAlarm 事件"
        },
        "encounter": {
          "type": "object",
          "properties": {
            "detectionRange_nm": {
              "$ref": "#/$defs/numberOrParam",
              "default": 6,
              "description": "「首次偵測」= 目標進入此距離且 TCPA > 0"
            },
            "substantialCourseChange_deg": {
              "$ref": "#/$defs/numberOrParam",
              "default": 30
            },
            "substantialSpeedChange_kn": {
              "$ref": "#/$defs/numberOrParam",
              "default": 2
            },
            "cpaInterest_nm": {
              "$ref": "#/$defs/numberOrParam",
              "description": "會遇開始的 CPA 關注門檻(預設 2 × minCpa_nm)"
            }
          }
        },
        "ukc": {
          "type": "object",
          "properties": {
            "min": {
              "$ref": "#/$defs/ukcLimit"
            }
          }
        },
        "manoeuvring": {
          "type": "object",
          "properties": {
            "rotLimit_degPerMin": {
              "$ref": "#/$defs/numberOrParam"
            },
            "hardOver_deg": {
              "$ref": "#/$defs/numberOrParam",
              "description": "滿舵角;未給時取船舶 rudder.maxAngle_deg(FSB1 70、FSB2 35)"
            }
          }
        },
        "hardFail": {
          "type": "array",
          "description": "任一成立 → passed = false",
          "items": {
            "$ref": "#/$defs/hardFailRule"
          }
        },
        "bands": {
          "type": "array",
          "description": "容許帶與扣分",
          "items": {
            "$ref": "#/$defs/bandRule"
          }
        },
        "required": {
          "type": "array",
          "description": "必要事件(第一版只用可自動偵測者)",
          "items": {
            "$ref": "#/$defs/requiredEvent"
          }
        },
        "scoring": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "#/$defs/numberOrParam",
              "default": 100
            },
            "passMark": {
              "$ref": "#/$defs/numberOrParam",
              "default": 70
            },
            "appliesTo": {
              "type": "object",
              "description": "保留:依階段加權(第一版不實作)"
            }
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "description": "事件時間表(情境引擎設計第 1.1 節;每秒評估;Python 參考實作忽略)",
      "items": {
        "$ref": "#/$defs/timelineItem"
      }
    },
    "route": {
      "$ref": "#/$defs/route"
    },
    "zones": {
      "type": "array",
      "description": "區域多邊形(noGo | speedLimit | ukcPolicy | reporting)",
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "briefing": {
      "description": "簡報:字串(等同 {text})或物件",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/briefing"
        }
      ]
    },
    "sensors": {
      "type": "object",
      "description": "感測器常態參數(docs/design/sensors-alerts.md 第 2 節;Python 參考實作忽略)",
      "properties": {
        "magneticCompassError_deg": {
          "$ref": "#/$defs/numberOrParam",
          "description": "磁羅經修正後剩餘誤差(度;磁羅經指示 = 真航向 + 此值;預設 0)"
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "description": "警報管理(BAM,MSC.302(87);sensors-alerts.md 第 3 節):故障類警報一律啟用;門檻類(偏航、航向監視、淺水)未設定即關閉(Python 參考實作忽略)",
      "properties": {
        "escalate_s": {
          "$ref": "#/$defs/numberOrParam",
          "description": "warning 未確認升級為 alarm 的秒數(預設 300)"
        },
        "silence_s": {
          "$ref": "#/$defs/numberOrParam",
          "description": "靜音後重響秒數(預設 30)"
        },
        "offHeading_deg": {
          "$ref": "#/$defs/numberOrParam",
          "description": "自動舵偏航警報門檻(|設定航向 − 指示航向|;未設 = 關閉)"
        },
        "offHeadingDelay_s": {
          "$ref": "#/$defs/numberOrParam",
          "description": "偏航持續秒數(預設 10)"
        },
        "headingMonitor_deg": {
          "$ref": "#/$defs/numberOrParam",
          "description": "航向監視(電羅經 vs 磁羅經)差異門檻(未設 = 關閉)"
        },
        "shallowWater_m": {
          "$ref": "#/$defs/numberOrParam",
          "description": "測深儀淺水警報(指示龍骨下水深 < 此值;未設 = 關閉)"
        }
      },
      "additionalProperties": false
    },
    "bnwas": {
      "type": "object",
      "description": "BNWAS(MSC.128(75);sensors-alerts.md 第 4 節;預設 off;Python 參考實作忽略)。YAML 的 on/off 請加引號",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "on"
          ],
          "description": "auto = 自動舵啟用時作動"
        },
        "dormant_s": {
          "$ref": "#/$defs/numberOrParam",
          "description": "休眠期 180–720 s(預設 720)"
        },
        "stage2_s": {
          "$ref": "#/$defs/numberOrParam",
          "description": "第一 → 第二階段(預設 15 s)"
        },
        "stage3_s": {
          "$ref": "#/$defs/numberOrParam",
          "description": "第二 → 第三階段(預設 90 s)"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "id": "E01_baseline",
      "seed": 20260101,
      "ship": {
        "id": "FSB1",
        "loading": "ballast"
      },
      "initial": {
        "position": {
          "lat": 23.8,
          "lon": 120.05
        },
        "heading": 0,
        "speed": 7.8,
        "telegraph": "HAH"
      },
      "environment": {
        "wind": {
          "trueSpeed": 15,
          "trueDir": 45
        },
        "current": {
          "set": 200,
          "drift": 0.5
        },
        "waterDepth": 30,
        "visibility_nm": 10
      },
      "assessment": {
        "minCpa_nm": 0.5,
        "hardFail": [
          {
            "id": "collision",
            "rule": "collision"
          },
          {
            "id": "grounding",
            "rule": "grounding"
          }
        ],
        "bands": [
          {
            "id": "minCpa",
            "metric": "collisionAvoidance.minCpa_nm",
            "direction": "below",
            "warn": 1.0,
            "fail": 0.5,
            "penalty": 10,
            "failPenalty": 30
          }
        ],
        "scoring": {
          "start": 100,
          "passMark": 70
        }
      },
      "targets": [
        {
          "id": "T1",
          "name": "HAI XING 8",
          "mmsi": 416123456,
          "shipType": "cargo",
          "loa": 120,
          "beam": 19,
          "initial": {
            "position": {
              "x": -100,
              "y": 9260
            },
            "heading": 180,
            "speed": 9
          },
          "behaviour": {
            "mode": "colreg",
            "colreg": {
              "obey": true,
              "cpaThreshold": 1.0,
              "tcpaThreshold": 12,
              "turn": 30
            }
          }
        },
        {
          "id": "T2",
          "shipType": "tanker",
          "loa": 90,
          "beam": 15,
          "initial": {
            "position": {
              "x": 1500,
              "y": 2200
            },
            "heading": 45
          },
          "behaviour": {
            "mode": "anchored"
          }
        },
        {
          "id": "PILOT",
          "shipType": "pilot",
          "loa": 18,
          "beam": 5,
          "initial": {
            "position": {
              "lat": 23.82,
              "lon": 120.06
            },
            "heading": 0
          },
          "behaviour": {
            "mode": "follow",
            "follow": {
              "leader": "own",
              "bearing": 120,
              "range": 70
            }
          },
          "trigger": {
            "type": "ownDistance",
            "point": {
              "lat": 23.82,
              "lon": 120.06
            },
            "lessThan": 1.5
          }
        }
      ],
      "briefing": "麥寮港外開闊水域;熟悉儀器與標準用語,觀察對遇目標並依 COLREG 行動。",
      "route": {
        "name": "北向航線",
        "xtdLimit_m": 300,
        "waypoints": [
          {
            "name": "WP1",
            "x": 0,
            "y": 0
          },
          {
            "name": "WP2",
            "x": 0,
            "y": 12000,
            "checkpoint": true
          }
        ]
      },
      "timeline": [
        {
          "id": "ecrCheck",
          "name": "機控室例行通話",
          "when": {
            "type": "time",
            "atLeast": 300
          },
          "actions": [
            {
              "voiceScript": {
                "role": "ecr",
                "channel": "phone",
                "text": "駕駛台,機控室。主機運轉正常。",
                "lang": "zh-TW"
              }
            }
          ]
        },
        {
          "id": "steeringFail",
          "name": "舵機故障",
          "phase": "degraded",
          "when": {
            "all": [
              {
                "type": "routeLeg",
                "atLeast": 0
              },
              {
                "type": "time",
                "atLeast": 600
              }
            ]
          },
          "actions": [
            {
              "injectFault": "steeringGear"
            },
            {
              "message": {
                "to": "instructor",
                "text": "已注入舵機故障",
                "severity": "warning"
              }
            }
          ]
        },
        {
          "id": "emergencySteering",
          "manual": true,
          "actions": [
            {
              "clearFault": "steeringGear"
            },
            {
              "phase": "normal"
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "description": "經緯度或本地 ENU(m),二擇一",
      "oneOf": [
        {
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        {
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "description": "本地 ENU 東向 (m)"
            },
            "y": {
              "type": "number",
              "description": "本地 ENU 北向 (m)"
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "description": "目標船(規劃書第 5.2 節 Traffic、第 9.1 節):靜態資料、初始狀態、行為、觸發、AIS",
      "required": [
        "id",
        "initial"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "情境內唯一;targetControl 指令與狀態 targets[].id 以此引用"
        },
        "name": {
          "type": "string",
          "description": "船名(AIS;未指定用 id)"
        },
        "mmsi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999,
          "description": "未指定時自 416000001 起依序配置"
        },
        "shipType": {
          "type": "string",
          "enum": [
            "cargo",
            "tanker",
            "fishing",
            "pilot",
            "tug",
            "passenger",
            "pleasure",
            "sar",
            "hsc",
            "sailing",
            "other"
          ],
          "default": "cargo"
        },
        "loa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 100,
          "description": "總長 (m)"
        },
        "beam": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 16,
          "description": "船寬 (m)"
        },
        "draft": {
          "type": "number",
          "minimum": 0,
          "default": 5
        },
        "callSign": {
          "type": "string"
        },
        "imo": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "lights": {
          "type": "string",
          "enum": [
            "powerDriven",
            "anchored",
            "notUnderCommand",
            "restrictedManoeuvrability",
            "constrainedByDraught",
            "fishing",
            "towing",
            "pilot",
            "sailing"
          ],
          "description": "燈號類別;未指定依行為(錨泊)與船型(引水、漁船)推定"
        },
        "aisOn": {
          "type": "boolean",
          "default": true
        },
        "aisError": {
          "type": "object",
          "description": "AIS 錯誤資料注入",
          "properties": {
            "positionOffset": {
              "type": "number",
              "minimum": 0,
              "description": "位置偏移 (m)"
            },
            "positionOffsetBearing": {
              "type": "number",
              "description": "偏移方向(真方位,度)"
            },
            "headingError": {
              "type": "number",
              "description": "航向誤差(度)"
            },
            "cogError": {
              "type": "number"
            },
            "sogError": {
              "type": "number",
              "description": "kn"
            },
            "staticError": {
              "type": "boolean",
              "description": "靜態資料錯誤(預設:船名加 \" II\"、船型 pleasure、尺寸減半;可用 name/shipType/mmsi 指定)"
            },
            "name": {
              "type": "string"
            },
            "shipType": {
              "type": "string"
            },
            "mmsi": {
              "type": "integer"
            },
            "silent": {
              "type": "boolean",
              "description": "AIS 開啟但不發送"
            }
          }
        },
        "initial": {
          "type": "object",
          "required": [
            "position"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/position"
            },
            "heading": {
              "type": "number",
              "minimum": 0,
              "maximum": 360,
              "default": 0
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "default": 0,
              "description": "對水速度 (kn)"
            },
            "rot": {
              "type": "number",
              "default": 0,
              "description": "初始迴轉率(度/分)"
            }
          }
        },
        "behaviour": {

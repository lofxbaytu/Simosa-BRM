          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inside": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "itemId": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "count": {
          "type": "object",
          "properties": {
            "atLeast": {
              "type": "integer",
              "default": 1

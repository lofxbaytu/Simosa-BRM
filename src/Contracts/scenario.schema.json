                },
                "range": {
                  "type": "number",
                  "default": 80,
                  "description": "m"
                },
                "gain": {
                  "type": "number",
                  "default": 0.05,
                  "description": "位置誤差 → 速度修正 (1/s)"
                },
                "maxSpeed": {
                  "type": "number",
                  "default": 15,
                  "description": "kn"
                }
              }
            },
            "colreg": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "obey": {
                  "type": "boolean",
                  "default": true,
                  "description": "false = 不守規則(辨識情境但不行動)"
                },
                "cpaThreshold": {
                  "type": "number",
                  "default": 1.0,
                  "description": "nm"
                },
                "tcpaThreshold": {
                  "type": "number",
                  "default": 12,
                  "description": "分"
                },
                "turn": {
                  "type": "number",
                  "default": 30,
                  "description": "每次轉向幅度(度)"
                },
                "speedFactor": {
                  "type": "number",
                  "default": 0.7,
                  "description": "橫越讓路時的減速倍率"
                },
                "escalateAfter": {
                  "type": "number",
                  "default": 60,
                  "description": "秒"
                },
                "lastResort": {
                  "type": "boolean",
                  "default": true,
                  "description": "直航船的第 17 條最後手段"
                }

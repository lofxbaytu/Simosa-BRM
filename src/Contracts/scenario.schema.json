                  }
                }
              }
            },
            "anchor": {
              "type": "object",
              "properties": {
                "swing": {
                  "type": "number",
                  "default": 15,
                  "description": "迴盪振幅(度)"
                },
                "period": {
                  "type": "number",
                  "default": 360,
                  "description": "迴盪週期(秒)"
                },
                "scope": {
                  "type": "number",
                  "description": "錨位至船舯距離 (m;預設船長)"
                }
              }
            },
            "follow": {

              "type": "boolean",
              "default": false
            },
            "stopAtEnd": {
              "type": "boolean",
              "default": false
            },
            "script": {
              "type": "array",
              "description": "時間觸發的指令表(秒,自出現起)",
              "items": {
                "type": "object",
                "required": [
                  "t"
                ],
                "properties": {
                  "t": {
                    "type": "number"
                  },
                  "heading": {
                    "type": "number"
                  },
                  "speed": {
                    "type": "number"
                  },
                  "rot": {
                    "type": "number",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simosa-brm/contracts/state.schema.json",
  "title": "OwnShipState",
  "description": "模擬核心每個廣播週期(25 Hz)對各站(儀器、視景、雷達、教官站、講評站)送出的自船狀態。Python 參考實作與 C# SimCore 必須產生相同欄位(Python 無目標船,不輸出 targets)。角度一律以度表示、航向 0 至 360、舵角右正左負、ROT 右轉正(度/分)。 感測器層(docs/design/sensors-alerts.md):heading/pos/cog/sog/stw/depthBelowKeel 為指示值,真值在 truth;另有 sensors(有效性、磁羅經)、autopilot、alerts[](BAM)、bnwas(C# 產生,Python 不輸出)。",
  "type": "object",
  "required": [
    "t",
    "shipId",
    "pos",
    "heading",
    "cog",
    "sog",
    "stw",
    "rot",
    "u",
    "v",
    "r",
    "rudder",
    "rudderOrder",
    "rpm",
    "rpmOrder",
    "telegraph",
    "depthBelowKeel",
    "wind",
    "current",
    "loading",
    "tick"
  ],
  "properties": {
    "t": {
      "type": "number",
      "description": "模擬時間(秒,自練習開始)"
    },
    "tick": {
      "type": "integer",
      "description": "核心步數(50 Hz)"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC 時刻(ISO 8601,例 2026-01-01T02:00:05.040Z)= 練習開始時刻 + t;開始時刻為情境 startTimeUtc,未給時為載入情境時的實際時鐘(核心寫回情境,重播沿用紀錄標頭);選填、不進雜湊;視景日夜據此"
    },
    "shipId": {
      "type": "string",
      "enum": [
        "FSB1",
        "FSB2"
      ]
    },
    "pos": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "x",
        "y"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "x": {
          "type": "number",
          "description": "本地 ENU 東向 (m)"
        },
        "y": {
          "type": "number",
          "description": "本地 ENU 北向 (m)"
        }
      },
      "description": "位置(指示值:GNSS;gpsJump/gpsOffset 時偏移,gpsFailure 時保持最後值且 sensors.positionValid = false;真值見 truth.pos)"
    },
    "heading": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "航向(度,0–360;指示值:電羅經。gyroDrift/gyroFreeze 時與真值不同,gyroFailure 時保持最後值且 sensors.headingValid = false;真值見 truth.heading)"
    },
    "cog": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "對地航向(度;指示值:GNSS,gpsFailure 時保持最後值)"
    },
    "sog": {
      "type": "number",
      "description": "對地速度(kn;指示值:GNSS,gpsFailure 時保持最後值)"
    },
    "stw": {
      "type": "number",
      "description": "對水速度(kn;指示值:計程儀,logFailure 時保持最後值或依 bias/factor 偏差;真值見 truth.stw)"
    },
    "rot": {
      "type": "number",
      "description": "迴轉率 (度/分),右轉正"
    },
    "u": {
      "type": "number",
      "description": "船體座標縱向速度 (m/s)"
    },
    "v": {
      "type": "number",
      "description": "船體座標橫向速度 (m/s),右正(MMG 慣例:船舯)"
    },
    "r": {
      "type": "number",
      "description": "艏搖角速度 (rad/s)"
    },
    "drift": {
      "type": "number",
      "description": "漂角 (度)"
    },
    "rudder": {
      "type": "number",
      "description": "實際舵角 (度)"
    },
    "rudderOrder": {
      "type": "number",
      "description": "舵令 (度)"
    },
    "rpm": {
      "type": "number",
      "description": "實際轉速,倒車負"
    },
    "rpmOrder": {
      "type": "number"
    },
    "telegraph": {
      "type": "string",
      "enum": [
        "EFAS",
        "FAS",
        "HAS",
        "SAS",
        "DSAS",
        "STOP",
        "DSAH",
        "SAH",
        "HAH",
        "FAH",
        "NAVF"
      ]
    },
    "thruster": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "actual": {
          "type": "number"
        }
      }
    },
    "depthBelowKeel": {
      "type": "number",
      "description": "龍骨下水深(m;指示值:測深儀,echoSounderFailure 時保持最後值且 sensors.depthValid = false;真值見 truth.depthBelowKeel)"
    },
    "waterDepth": {
      "type": "number",
      "description": "有效水深(m)= 基底水深(海圖水深,含 zones 覆寫與 setEnvironment 漸變)+ 潮高"
    },
    "tideHeight_m": {
      "type": "number",
      "description": "潮高(m;情境有 environment.tide 時輸出,由練習時間決定;無潮汐情境省略)"
    },
    "squat": {
      "type": "number"
    },
    "wind": {
      "type": "object",
      "required": [
        "trueSpeed",
        "trueDir"
      ],
      "properties": {
        "trueSpeed": {
          "type": "number",
          "description": "kn"
        },
        "trueDir": {
          "type": "number",
          "description": "來向,度"
        },
        "relSpeed": {
          "type": "number"
        },
        "relDir": {
          "type": "number"
        }
      }
    },
    "current": {
      "type": "object",
      "required": [
        "set",
        "drift"
      ],
      "description": "流(情境 environment.current 為時變流場時數值隨練習時間變化;為空間網格 field 時為自船位置的值;見 currentSource)",
      "properties": {
        "set": {
          "type": "number",
          "description": "流向(去向),度"
        },
        "drift": {
          "type": "number",
          "description": "kn"
        }
      }
    },
    "currentSource": {
      "type": "string",
      "enum": [
        "table",
        "tidal",
        "field",
        "field+tidal",
        "field+table"
      ],
      "description": "流場來源:情境 environment.current 為流場表(table)、潮流(tidal)或空間網格(field;timeScale 為 tidal/table 時 field+tidal / field+table)且未被 setEnvironment current 覆寫時輸出;常數流(含覆寫後)省略"
    },
    "loading": {
      "type": "string",
      "enum": [
        "full",
        "ballast",
        "intermediate"
      ]
    },
    "draft": {
      "type": "object",
      "properties": {
        "fore": {
          "type": "number"
        },
        "aft": {
          "type": "number"
        }
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "stopped",
            "running",
            "starting",
            "failed"
          ],
          "description": "failed:mainEngine 故障,或 engineStartFailure 連續 3 次起動失敗而起動封鎖(車令回 STOP 解除);starting:起動/換向中(含 engineStartFailure 的延遲與自動再試)"
        },
        "startsRemaining": {
          "type": "integer",
          "description": "剩餘連續起動次數(particulars engine.maxConsecutiveStarts;每次由停俥起動或換向下令計一次,engineStartFailure 的每次自動再試另計一次)"
        },
        "load_pct": {
          "type": "number"
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "object",
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "aground": {
          "type": "boolean"
        },
        "collision": {
          "type": "boolean",
          "description": "自船與任一目標船外形曾相交"
        }
      }
    },
    "steering": {
      "type": "object",
      "required": [
        "mode",
        "pump"
      ],
      "description": "操舵模式(規劃書第 7.2 節操舵模式選擇;C# SimCore 與 Python 參考實作皆輸出)。mode 由指令 steeringMode 切換;autopilot 與 autopilot{enabled:true} 同義;rudder 指令會把 autopilot/nfu 切回 fu;emergency 為應急操舵(舵機故障時舵以降低的速率再度可動)",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fu",
            "nfu",
            "autopilot",
            "emergency"
          ]
        },
        "pump": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "both"
          ],
          "description": "使用中的舵機泵"
        },
        "nfuActive": {
          "type": "boolean",
          "description": "nfu 模式時舵是否正被推動(direction port/starboard 中);其他模式省略"
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "已出現的目標船(情境無目標船時省略;規劃書第 5.2 節 Traffic、第 8.3 節避碰指標)。位置/航向/速度為真值;AIS 報告值(含注入錯誤)在 ais,AIS 關或不發送時省略",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "visibility_nm": {
      "type": "number",
      "description": "能見度(nm;未設定時省略;無物理效果)"
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "phase"
      ],
      "description": "情境引擎狀態(情境引擎設計第 5.1 節)",
      "properties": {
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "parameterSetVersion": {
          "type": "string"
        },
        "timelineFired": {
          "type": "integer",
          "description": "時間表項目累計觸發次數"
        },
        "timelinePending": {
          "type": "integer",
          "description": "待執行(delay_s 排程中、尚未執行)的時間表動作數;不是待觸發項目數(由教官站依事件推導)"
        },
        "hardFailed": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "ended": {
          "type": "boolean"
        }
      }
    },
    "route": {
      "type": "object",
      "description": "航線狀態(規劃書第 7.2 節 conning 的 XTD/下一航點;情境無 route 時省略)",
      "properties": {
        "legIndex": {
          "type": "integer"
        },
        "nextWaypoint": {
          "type": "string"
        },
        "xtd_m": {
          "type": "number",
          "description": "右正左負"
        },
        "xtdLimit_m": {
          "type": "number"
        },
        "distanceToWaypoint_nm": {
          "type": "number"
        },
        "bearingToWaypoint_deg": {
          "type": "number"
        },
        "legCourse_deg": {
          "type": "number"
        },
        "speedLimit_kn": {
          "type": "number"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "truth": {
      "type": "object",
      "description": "真值(教官站/講評用,學員端儀器不應顯示;C# SimCore 產生,Python 不輸出)。頂層 heading/pos/cog/sog/stw/depthBelowKeel 為感測器指示值,感測器故障時與此不同(docs/design/sensors-alerts.md 第 2 節)",
      "required": [
        "heading",
        "pos",
        "cog",
        "sog",
        "stw",
        "depthBelowKeel",
        "headingError_deg",
        "positionError_m"
      ],
      "properties": {
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "pos": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "x",
            "y"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "x": {
              "type": "number",
              "description": "本地 ENU 東向 (m)"
            },
            "y": {
              "type": "number",
              "description": "本地 ENU 北向 (m)"
            }
          },
          "description": "位置(指示值:GNSS;gpsJump/gpsOffset 時偏移,gpsFailure 時保持最後值且 sensors.positionValid = false;真值見 truth.pos)"
        },
        "cog": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "sog": {
          "type": "number",
          "description": "kn"
        },
        "stw": {
          "type": "number",
          "description": "kn"
        },
        "depthBelowKeel": {
          "type": "number",
          "description": "m"
        },
        "headingError_deg": {
          "type": "number",
          "description": "指示航向 − 真航向(度,−180..180,右正)"
        },
        "positionError_m": {
          "type": "number",
          "minimum": 0,
          "description": "指示位置與真位置距離(m)"
        }
      }
    },
    "sensors": {
      "type": "object",
      "description": "感測器有效性(false 時對應頂層欄位為最後有效值,儀器端應標示無效/可疑;NMEA 依 IEC 61162-1 停送或標無效)與磁羅經指示;Python 不輸出",
      "required": [
        "headingValid",
        "positionValid",
        "depthValid",
        "stwValid",
        "magneticHeading"
      ],
      "properties": {
        "headingValid": {
          "type": "boolean",
          "description": "電羅經(gyroFailure 時 false)"
        },
        "positionValid": {
          "type": "boolean",
          "description": "GNSS(gpsFailure 時 false)"
        },
        "depthValid": {
          "type": "boolean",
          "description": "測深儀(echoSounderFailure 時 false)"
        },
        "stwValid": {
          "type": "boolean",
          "description": "計程儀(logFailure 無 bias/factor 參數時 false)"
        },
        "magneticHeading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "磁羅經指示(修正自差/磁差後的真航向 = 真航向 + scenario sensors.magneticCompassError_deg;不受電羅經故障影響)"
        }
      }
    },
    "autopilot": {
      "type": "object",
      "description": "自動舵狀態;自動舵以電羅經指示航向操舵(gyroDrift 時跟隨錯誤航向),autopilotFailure 或 gyroFailure 時脫開(事件 autopilotTripped)且 available = false;Python 不輸出",
      "required": [
        "enabled",
        "setHeading",
        "rotLimit_degPerMin",
        "available"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "setHeading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "設定航向(度)"
        },
        "rotLimit_degPerMin": {
          "type": "number"
        },
        "available": {
          "type": "boolean",
          "description": "可啟用(無 autopilotFailure 且 sensors.headingValid)"
        }
      }
    },
    "alerts": {
      "type": "array",
      "description": "警報清單(BAM,MSC.302(87);依 priority、raisedAt_s 排序;無警報時省略;Python 不輸出)。指令 alertAcknowledge / alertSilence / alertTransfer 操作;station / transferredTo 為工作站與責任轉移(docs/design/sensors-alerts.md 第 3.6 節)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "priority",
          "category",
          "source",
          "state",
          "text",
          "raisedAt_s",
          "escalated",
          "count",
          "audible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "警報 id:故障類 = 故障名稱(gyroFailure、gpsFailure、echoSounderFailure、logFailure、autopilotFailure、steeringGear、steeringFuOnly、steeringPumpFailure、mainEngine、bowThruster);門檻類 shallowWater、offHeading、headingMonitor;bnwas"
          },
          "number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "description": "NMEA ALR 警報編號"
          },
          "priority": {
            "type": "string",
            "enum": [
              "emergencyAlarm",
              "alarm",
              "warning",
              "caution"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "source": {
            "type": "string",
            "description": "gyro | gnss | echoSounder | log | autopilot | steering | engine | thruster | bnwas"
          },
          "state": {
            "type": "string",
            "enum": [
              "activeUnacknowledged",
              "activeSilenced",
              "activeAcknowledged",
              "rectifiedUnacknowledged"
            ]
          },
          "text": {
            "type": "string",
            "description": "顯示文字(繁體中文)"
          },
          "raisedAt_s": {
            "type": "number",
            "description": "最近一次成立的模擬時間"
          },
          "acknowledgedAt_s": {
            "type": "number"
          },
          "silencedUntil_s": {
            "type": "number",
            "description": "靜音結束時間(activeSilenced 時)"
          },
          "escalated": {
            "type": "boolean",
            "description": "曾升級(warning 未確認逾時 → alarm;BNWAS 第二階段 caution → alarm)"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "description": "成立次數"
          },
          "audible": {
            "type": "boolean",
            "description": "目前有聲響(activeUnacknowledged 且 priority 為 emergencyAlarm/alarm/warning)"
          },
          "station": {
            "type": "string",
            "enum": ["bridge", "portWing", "stbdWing", "ecr"],
            "description": "負責站(相關工作站;MSC.302(87) 第 6 節;本版成立時皆為 bridge)。Category A 警報只能在負責站以 alertAcknowledge {id, station} 確認(未帶 station 視為 bridge);Category B 任一站皆可"
          },
          "transferredTo": {
            "type": "string",
            "enum": ["bridge", "portWing", "stbdWing", "ecr"],
            "description": "責任已轉移到的站(MSC.302(87) 第 7.3 節 responsibility transferred;指令 alertTransfer {id, station});未轉移時省略。轉移後只有接收站可確認"
          }
        }
      }
    },
    "bnwas": {
      "type": "object",
      "description": "BNWAS(MSC.128(75))狀態;指令 bnwasMode / bnwasReset;Python 不輸出",
      "required": [
        "mode",
        "active",
        "stage",
        "dormant_s"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "on"
          ]
        },
        "active": {
          "type": "boolean",
          "description": "作動中(on,或 auto 且自動舵啟用)"
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0 休眠、1 駕駛台視覺指示、2 駕駛台聲響、3 後備值班官/船長"
        },
        "remaining_s": {
          "type": "number",
          "description": "距下一階段秒數(未作動或第三階段時省略)"
        },
        "dormant_s": {
          "type": "number",
          "minimum": 180,
          "maximum": 720
        }
      }
    },
    "tugs": {
      "type": "array",
      "description": "拖船(情境 tugs[];無拖船時省略;C# 與 Python 參考實作皆輸出(simosa_brm/external.py);docs/design/physics-tugs-anchors-mooring.md 第 2、5 節)。力以噸力(t)、方向相對船艏順時針(度)",
      "items": {
        "type": "object",
        "required": ["id", "mode", "status", "force_t", "direction_deg"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mode": { "type": "string", "enum": ["push", "pull", "standby", "free", "unavailable"] },
          "status": { "type": "string", "enum": ["standby", "connecting", "repositioning", "working", "free", "parted", "unavailable"], "description": "unavailable = 已離開、本練習不再可用(tugControl mode unavailable;之後的指令以 tugUnavailable 拒絕)" },
          "force_t": { "type": "number", "minimum": 0, "description": "實際出力(t)" },
          "direction_deg": { "type": "number", "minimum": 0, "maximum": 360, "description": "實際力方向(相對船艏;0 向前、90 向右舷)" },
          "directionOrder_deg": { "type": "number", "minimum": 0, "maximum": 360 },
          "power_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "efficiency": { "type": "number", "minimum": 0, "maximum": 1, "description": "自船對水速度造成的效能" },
          "bollardPull_t": { "type": "number" },
          "lineParted": { "type": "boolean" },
          "pos": { "type": "object", "description": "示意位置(lat, lon, x, y;顯示用,非物理)" }
        }
      }
    },
    "anchors": {
      "type": "array",
      "description": "左右錨(particulars 有 anchors 資料時一律輸出;C# 與 Python 參考實作皆輸出;第 3、5 節)",
      "items": {
        "type": "object",
        "required": ["side", "status", "length_m", "tension_t", "onBottom_m"],
        "properties": {
          "side": { "type": "string", "enum": ["port", "starboard"] },
          "status": { "type": "string", "enum": ["stowed", "running", "holding", "dragging", "heaving", "aweigh"] },
          "length_m": { "type": "number", "minimum": 0, "description": "送出鏈長(m)" },
          "length_shackles": { "type": "number", "minimum": 0 },
          "maxLength_m": { "type": "number" },
          "tension_t": { "type": "number", "minimum": 0, "description": "錨鏈孔處張力(t)" },
          "horizontalTension_t": { "type": "number", "minimum": 0 },
          "onBottom_m": { "type": "number", "minimum": 0, "description": "躺底鏈長(m)" },
          "holding_t": { "type": "number", "minimum": 0, "description": "目前抓地力(錨 + 躺底鏈摩擦,t)" },
          "brake": { "type": "boolean" },
          "fullyOut": { "type": "boolean", "description": "已到鏈端" },
          "position": { "type": "object", "description": "錨位 {lat, lon, x, y}(收存時省略)" }
        }
      }
    },
    "berth": {
      "type": "object",
      "description": "泊位(情境 berth;無時省略;第 4、5 節)",
      "required": ["id", "contacts", "lines"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quayContact": { "type": "boolean", "description": "船體與碼頭面硬接觸中" },
        "contacts": {
          "type": "array",
          "description": "目前受壓的碰墊",
          "items": {
            "type": "object",
            "required": ["fenderId", "deflection_m", "reaction_kN"],
            "properties": {
              "fenderId": { "type": "string" },
              "deflection_m": { "type": "number", "minimum": 0 },
              "deflection_pct": { "type": "number", "minimum": 0 },
              "reaction_kN": { "type": "number", "minimum": 0 },
              "overload": { "type": "boolean", "description": "壓縮超過額定" }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "tension_t"],
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string", "enum": ["stowed", "fast", "heaving", "slacking", "letGo", "parted"] },
              "tension_t": { "type": "number", "minimum": 0 },
              "mbl_t": { "type": "number" },
              "bollardId": { "type": "string" },
              "length_m": { "type": "number", "description": "未受力纜長(未繫時省略)" }
            }
          }
        }
      }
    },
    "waves": {
      "type": "object",
      "description": "浪與平均二階波浪漂移力(情境有 environment.waves 且動力學接受外力時輸出;無 waves 的情境省略;C# 與 Python 參考實作皆輸出;docs/design/physics-waves.md 第 5 節)。視景以 significantHeight_m/direction_deg 畫海面(取代由風速推得的波高);力為船體座標:X 向艏正、Y 右舷正、N 艏向右正(與 u/v/r 相同)。3 自由度:只有平均漂移力,無一階振盪與橫搖",
      "required": ["significantHeight_m", "peakPeriod_s", "direction_deg", "wavelength_m"],
      "properties": {
        "significantHeight_m": { "type": "number", "minimum": 0, "description": "有義波高 Hs(m)" },
        "peakPeriod_s": { "type": "number", "exclusiveMinimum": 0, "description": "譜峰週期 Tp(s)" },
        "direction_deg": { "type": "number", "minimum": 0, "maximum": 360, "description": "浪來向(度,氣象慣例,與風相同)" },
        "wavelength_m": { "type": "number", "exclusiveMinimum": 0, "description": "峰值波長(m;自船位置的有效水深:水深 < 深水波長/2 時由有限水深色散關係求得)" },
        "spectrum": { "type": "string", "enum": ["pm", "jonswap"], "description": "浪譜" },
        "X_kN": { "type": "number", "description": "平均漂移力 surge(kN,向艏正;迎浪為負 = 阻力增加)" },
        "Y_kN": { "type": "number", "description": "平均漂移力 sway(kN,右舷正;浪自右舷來時為負)" },
        "N_kNm": { "type": "number", "description": "平均漂移力矩 yaw(kN·m,艏向右正)" }
      }
    },
    "shipInteraction": {
      "type": "object",
      "description": "船間交互作用(情境 environment.shipInteraction.enabled 且動力學接受外力時輸出;未啟用的情境省略;C# 與 Python 參考實作皆輸出;docs/design/physics-ship-interaction.md 第 5 節)。力為船體座標:surge 向艏正、sway 右舷正(向目標為吸引)、yaw 艏向右正(與 u/v/r 相同);單位噸力(t)與 t·m",
      "required": ["active", "forceSway_t", "momentYaw_tm"],
      "properties": {
        "active": { "type": "boolean", "description": "有目標船在作用範圍內(自船 3 倍船長內且橫向間距 < 2(B_o + B_t))" },
        "targetId": { "type": "string", "description": "主要目標(等效側向力最大者;無目標在範圍內時省略)" },
        "forceSurge_t": { "type": "number", "description": "交互作用 surge 力(t,向艏正)" },
        "forceSway_t": { "type": "number", "description": "交互作用 sway 力(t,右舷正)" },
        "momentYaw_tm": { "type": "number", "description": "交互作用 yaw 力矩(t·m,艏向右正)" },
        "xi": { "type": "number", "description": "主要目標的縱向錯位 ξ = (x_t − x_o)/L(正 = 目標在前;無目標時省略)" },
        "eta": { "type": "number", "description": "主要目標的橫向間距 η = y/L(正 = 目標在右舷;無目標時省略)" },
        "targets": { "type": "integer", "minimum": 0, "description": "範圍內的目標數" },
        "event": { "type": "boolean", "description": "交互作用力已超過事件門檻(shipInteraction 進入事件已發、離開未發)" }
      }
    },
    "roll": {
      "type": "object",
      "description": "橫搖(情境 ship.roll.enabled 時輸出;未啟用的情境省略,其他欄位與雜湊不變)。解耦的 1 自由度線性橫搖:φ'' + 2ζω φ' + ω² φ = ω²(φ_turn + φ_wind) + 浪激勵,不回饋到 3 自由度運動;φ_turn 為迴轉離心傾角(右轉向外 = 左傾)、φ_wind 為風傾等效靜傾角;浪激勵相位由情境種子產生一次(進快照)。視景相機(駕駛台/翼橋/艉視;觀察者隨船傾)與操船台傾斜儀據此顯示。角度右傾正",
      "required": ["angle_deg", "rate_degps", "naturalPeriod_s", "staticHeel_deg"],
      "properties": {
        "angle_deg": { "type": "number", "description": "橫搖角(度,右傾正)" },
        "rate_degps": { "type": "number", "description": "橫搖角速度(度/秒,右傾方向正)" },
        "naturalPeriod_s": { "type": "number", "exclusiveMinimum": 0, "description": "自然橫搖週期(秒;情境給定或依 GM 與船寬估計 T = 2·0.4·B/√GM)" },
        "staticHeel_deg": { "type": "number", "description": "靜傾角(度,右傾正;迴轉離心與風傾的等效靜傾;動態橫搖 = angle_deg − staticHeel_deg)" }
      }
    },
    "bank": {
      "type": "object",
      "description": "岸壁效應(情境有 banks 區段且動力學接受外力時輸出;C# 與 Python 參考實作皆輸出;docs/design/physics-bank-effect.md 第 5 節)。力為船體座標:Y 右舷正、N 艏向右正(與 u/v/r 相同)",
      "required": ["Y_kN", "N_kNm", "side", "parameter"],
      "properties": {
        "Y_kN": { "type": "number", "description": "岸壁橫向力(kN,右舷正;向岸吸力)" },
        "N_kNm": { "type": "number", "description": "岸壁艏搖力矩(kN·m,艏向右正;艏離岸時與 Y 反號)" },
        "side": { "type": "string", "enum": ["port", "starboard", "none"], "description": "岸壁橫向力 Y_kN 指向的舷側(Y 的正負;|Y| < 1e-6 N 時 none)。不等於岸在哪一舷:船艏先進入岸壁時艏部壓力墊使力推離岸;岸的舷側見 nearestSide,畫力箭頭以 Y_kN 為準" },
        "parameter": { "type": "number", "description": "加權距離參數 D(無因次;正 = 右舷岸較近,兩岸等距時 0)" },
        "distance_m": { "type": "number", "minimum": 0, "description": "船舯至最近等效岸壁的橫向距離(m;影響寬度內無岸壁時省略)" },
        "clearance_m": { "type": "number", "description": "船側至最近等效岸壁(distance_m − B/2)" },
        "nearestSide": { "type": "string", "enum": ["port", "starboard"], "description": "最近岸壁在哪一舷" },
        "bankId": { "type": "string", "description": "最近岸壁 id" },
        "port_m": { "type": "number", "minimum": 0, "description": "左舷最近等效岸壁距離(船舯,m;影響寬度內無時省略)" },
        "starboard_m": { "type": "number", "minimum": 0, "description": "右舷最近等效岸壁距離(船舯,m)" },
        "depthRatio": { "type": "number", "description": "水深吃水比 h/T" },
        "influence_m": { "type": "number", "description": "影響寬度 y_inf(自船舯,m)" }
      }
    },
    "radarEnvironment": {
      "type": "object",
      "description": "雷達環境(情境 environment.radar 換算為本地 ENU;情境未給時省略;C# 產生,Python 不輸出;docs/design/radar-arpa.md 第 2.1 節)。只來自情境、練習中不變(不進雜湊);廣播與紀錄只在關鍵幀帶出 — 載入/重設/倒帶後第一幀與之後每秒(50 步)一次 — 其他幀省略 = 不變(雷達服務於模擬時間倒退或 scenario.id 改變時清除,待下一個關鍵幀重新套用);雷達服務據以產生雨雜波與雨衰減、覆寫海況(教官 environment 指令優先)",
      "required": ["rainAreas"],
      "properties": {
        "rainAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "intensity", "rate_mmh"],
            "properties": {
              "id": { "type": "string", "description": "雨區 id(情境未給時 rain1、rain2…)" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "降雨強度 0–1(情境值)" },
              "rate_mmh": { "type": "number", "minimum": 0, "description": "降雨率(mm/h)= 16 × intensity" },
              "polygon": { "type": "array", "items": { "$ref": "#/properties/pos" }, "description": "多邊形雨區頂點(與 center + radius_m 二擇一)" },
              "center": { "$ref": "#/properties/pos", "description": "圓形雨區中心" },
              "radius_m": { "type": "number", "exclusiveMinimum": 0, "description": "圓形雨區半徑(m)" }
            }
          }
        },
        "seaState": { "type": "number", "minimum": 0, "maximum": 9, "description": "海況覆寫(Douglas 0–9;省略 = 雷達服務依真風速推估)" }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mmsi",
        "shipType",
        "loa",
        "beam",
        "pos",
        "heading",
        "cog",
        "sog",
        "rot",
        "range_nm",
        "bearing_deg",
        "cpa_nm",
        "tcpa_min",
        "aisOn",
        "lights",
        "behaviour"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mmsi": {
          "type": "integer"
        },
        "shipType": {
          "type": "string",
          "description": "cargo、tanker、fishing、pilot、tug、passenger、pleasure、sar、hsc、sailing、other"
        },
        "loa": {
          "type": "number",
          "description": "總長 (m)"
        },
        "beam": {
          "type": "number"
        },
        "draft": {
          "type": "number"
        },
        "pos": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "x",
            "y"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "x": {
              "type": "number",
              "description": "本地 ENU 東向 (m)"
            },
            "y": {
              "type": "number",
              "description": "本地 ENU 北向 (m)"
            }
          }
        },
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "cog": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "sog": {
          "type": "number",
          "description": "kn"
        },
        "stw": {
          "type": "number",
          "description": "對水速度 (kn)"
        },
        "rot": {
          "type": "number",
          "description": "度/分,右轉正"
        },
        "range_nm": {
          "type": "number",
          "description": "自船至目標距離 (nm)"
        },
        "bearing_deg": {
          "type": "number",
          "description": "自船看目標的真方位"
        },
        "relBearing_deg": {
          "type": "number",
          "description": "相對自船艏向 0–360"
        },
        "cpa_nm": {
          "type": "number"
        },
        "tcpa_min": {
          "type": "number",
          "description": "負值 = 已通過 CPA"
        },
        "bcr_nm": {
          "type": "number",
          "description": "艏越距離:正 = 由自船艏前通過、負 = 由艉後通過;無交會時省略"
        },
        "bct_min": {
          "type": "number",
          "description": "艏越時間(分)"
        },
        "aisOn": {
          "type": "boolean"
        },
        "lights": {
          "type": "string",
          "description": "燈號類別:powerDriven、anchored、notUnderCommand、restrictedManoeuvrability、constrainedByDraught、fishing、towing、pilot、sailing"
        },
        "sound": {
          "type": "string",
          "description": "鳴放中的聲號(oneShort、twoShort、threeShort、fiveShort、prolonged…);無時省略"
        },
        "behaviour": {
          "type": "string",
          "description": "hold、waypoints、scripted、anchored、follow、colreg;manual = 教官覆寫中"
        },
        "colreg": {
          "type": "string",
          "description": "COLREG 判定/行動,例如 crossing/giveWay/avoiding、headOn/giveWay/avoiding、crossing/standOn/holding、crossing/giveWay(ignored)、resumed"
        },
        "ais": {
          "type": "object",
          "description": "AIS 報告(ITU-R M.1371 類型 1/5 欄位;含注入錯誤)",
          "properties": {
            "mmsi": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "callSign": {
              "type": "string"
            },
            "imo": {
              "type": "integer"
            },
            "shipType": {
              "type": "integer",
              "description": "AIS 船型碼"
            },
            "navStatus": {
              "type": "integer"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "cog": {
              "type": "number"
            },
            "sog": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            },
            "rot": {
              "type": "number"
            },
            "dimToBow": {
              "type": "number"
            },
            "dimToStern": {
              "type": "number"
            },
            "dimToPort": {
              "type": "number"
            },
            "dimToStarboard": {
              "type": "number"
            },
            "draught": {
              "type": "number"
            },
            "destination": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

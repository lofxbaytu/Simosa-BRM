{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simosa-brm/contracts/state.schema.json",
  "title": "OwnShipState",
  "description": "模擬核心每個廣播週期(25 Hz)對各站(儀器、視景、雷達、教官站、講評站)送出的自船狀態。Python 參考實作與 C# SimCore 必須產生相同欄位(Python 無目標船,不輸出 targets)。角度一律以度表示、航向 0 至 360、舵角右正左負、ROT 右轉正(度/分)。 感測器層(docs/design/sensors-alerts.md):heading/pos/cog/sog/stw/depthBelowKeel 為指示值,真值在 truth;另有 sensors(有效性、磁羅經)、autopilot、alerts[](BAM)、bnwas(C# 產生,Python 不輸出)。",
  "type": "object",
  "required": [
    "t",
    "shipId",
    "pos",
    "heading",
    "cog",
    "sog",
    "stw",
    "rot",
    "u",
    "v",
    "r",
    "rudder",
    "rudderOrder",
    "rpm",
    "rpmOrder",
    "telegraph",
    "depthBelowKeel",
    "wind",
    "current",
    "loading",
    "tick"
  ],
  "properties": {
    "t": {
      "type": "number",
      "description": "模擬時間(秒,自練習開始)"
    },
    "tick": {
      "type": "integer",
      "description": "核心步數(50 Hz)"
    },
    "shipId": {
      "type": "string",
      "enum": [
        "FSB1",
        "FSB2"
      ]
    },
    "pos": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "x",
        "y"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "x": {
          "type": "number",
          "description": "本地 ENU 東向 (m)"
        },
        "y": {
          "type": "number",
          "description": "本地 ENU 北向 (m)"
        }
      },
      "description": "位置(指示值:GNSS;gpsJump/gpsOffset 時偏移,gpsFailure 時保持最後值且 sensors.positionValid = false;真值見 truth.pos)"
    },
    "heading": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "航向(度,0–360;指示值:電羅經。gyroDrift/gyroFreeze 時與真值不同,gyroFailure 時保持最後值且 sensors.headingValid = false;真值見 truth.heading)"
    },
    "cog": {
      "type": "number",
      "minimum": 0,
      "maximum": 360,
      "description": "對地航向(度;指示值:GNSS,gpsFailure 時保持最後值)"
    },
    "sog": {
      "type": "number",
      "description": "對地速度(kn;指示值:GNSS,gpsFailure 時保持最後值)"
    },
    "stw": {
      "type": "number",
      "description": "對水速度(kn;指示值:計程儀,logFailure 時保持最後值或依 bias/factor 偏差;真值見 truth.stw)"
    },
    "rot": {
      "type": "number",
      "description": "迴轉率 (度/分),右轉正"
    },
    "u": {
      "type": "number",
      "description": "船體座標縱向速度 (m/s)"
    },
    "v": {
      "type": "number",
      "description": "船體座標橫向速度 (m/s),右正(MMG 慣例:船舯)"
    },
    "r": {
      "type": "number",
      "description": "艏搖角速度 (rad/s)"
    },
    "drift": {
      "type": "number",
      "description": "漂角 (度)"
    },
    "rudder": {
      "type": "number",
      "description": "實際舵角 (度)"
    },
    "rudderOrder": {
      "type": "number",
      "description": "舵令 (度)"
    },
    "rpm": {
      "type": "number",
      "description": "實際轉速,倒車負"
    },
    "rpmOrder": {
      "type": "number"
    },
    "telegraph": {
      "type": "string",
      "enum": [
        "EFAS",
        "FAS",
        "HAS",
        "SAS",
        "DSAS",
        "STOP",
        "DSAH",
        "SAH",
        "HAH",
        "FAH",
        "NAVF"
      ]
    },
    "thruster": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "actual": {
          "type": "number"
        }
      }
    },
    "depthBelowKeel": {
      "type": "number",
      "description": "龍骨下水深(m;指示值:測深儀,echoSounderFailure 時保持最後值且 sensors.depthValid = false;真值見 truth.depthBelowKeel)"
    },
    "waterDepth": {
      "type": "number"
    },
    "squat": {
      "type": "number"
    },
    "wind": {
      "type": "object",
      "required": [
        "trueSpeed",
        "trueDir"
      ],
      "properties": {
        "trueSpeed": {
          "type": "number",
          "description": "kn"
        },
        "trueDir": {
          "type": "number",
          "description": "來向,度"
        },
        "relSpeed": {
          "type": "number"
        },
        "relDir": {
          "type": "number"
        }
      }
    },
    "current": {
      "type": "object",
      "required": [
        "set",
        "drift"
      ],
      "properties": {
        "set": {
          "type": "number",
          "description": "流向(去向),度"
        },
        "drift": {
          "type": "number",
          "description": "kn"
        }
      }
    },
    "loading": {
      "type": "string",
      "enum": [
        "full",
        "ballast",
        "intermediate"
      ]
    },
    "draft": {
      "type": "object",
      "properties": {
        "fore": {
          "type": "number"
        },
        "aft": {
          "type": "number"
        }
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "stopped",
            "running",
            "starting",
            "failed"
          ]
        },
        "startsRemaining": {
          "type": "integer"
        },
        "load_pct": {
          "type": "number"
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "object",
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "aground": {
          "type": "boolean"
        },
        "collision": {
          "type": "boolean",
          "description": "自船與任一目標船外形曾相交"
        }
      }
    },
    "steering": {
      "type": "object",
      "required": [
        "mode",
        "pump"
      ],
      "description": "操舵模式(規劃書第 7.2 節操舵模式選擇;C# SimCore 產生,Python 不輸出)。mode 由指令 steeringMode 切換;autopilot 與 autopilot{enabled:true} 同義;rudder 指令會把 autopilot/nfu 切回 fu;emergency 為應急操舵(舵機故障時舵以降低的速率再度可動)",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fu",
            "nfu",
            "autopilot",
            "emergency"
          ]
        },
        "pump": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "both"
          ],
          "description": "使用中的舵機泵"
        },
        "nfuActive": {
          "type": "boolean",
          "description": "nfu 模式時舵是否正被推動(direction port/starboard 中);其他模式省略"
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "已出現的目標船(情境無目標船時省略;規劃書第 5.2 節 Traffic、第 8.3 節避碰指標)。位置/航向/速度為真值;AIS 報告值(含注入錯誤)在 ais,AIS 關或不發送時省略",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "visibility_nm": {
      "type": "number",
      "description": "能見度(nm;未設定時省略;無物理效果)"
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "phase"
      ],
      "description": "情境引擎狀態(情境引擎設計第 5.1 節)",
      "properties": {
        "id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "parameterSetVersion": {
          "type": "string"
        },
        "timelineFired": {
          "type": "integer",
          "description": "時間表項目累計觸發次數"
        },
        "timelinePending": {
          "type": "integer",
          "description": "待執行(delay_s 排程中、尚未執行)的時間表動作數;不是待觸發項目數(由教官站依事件推導)"
        },
        "hardFailed": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "ended": {
          "type": "boolean"
        }
      }
    },
    "route": {
      "type": "object",
      "description": "航線狀態(規劃書第 7.2 節 conning 的 XTD/下一航點;情境無 route 時省略)",
      "properties": {
        "legIndex": {
          "type": "integer"
        },
        "nextWaypoint": {
          "type": "string"
        },
        "xtd_m": {
          "type": "number",
          "description": "右正左負"
        },
        "xtdLimit_m": {
          "type": "number"
        },
        "distanceToWaypoint_nm": {
          "type": "number"
        },
        "bearingToWaypoint_deg": {
          "type": "number"
        },
        "legCourse_deg": {
          "type": "number"
        },
        "speedLimit_kn": {
          "type": "number"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "truth": {
      "type": "object",
      "description": "真值(教官站/講評用,學員端儀器不應顯示;C# SimCore 產生,Python 不輸出)。頂層 heading/pos/cog/sog/stw/depthBelowKeel 為感測器指示值,感測器故障時與此不同(docs/design/sensors-alerts.md 第 2 節)",
      "required": [
        "heading",
        "pos",
        "cog",
        "sog",
        "stw",
        "depthBelowKeel",
        "headingError_deg",
        "positionError_m"
      ],
      "properties": {
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "pos": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "x",
            "y"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "x": {
              "type": "number",
              "description": "本地 ENU 東向 (m)"
            },
            "y": {
              "type": "number",
              "description": "本地 ENU 北向 (m)"
            }
          },
          "description": "位置(指示值:GNSS;gpsJump/gpsOffset 時偏移,gpsFailure 時保持最後值且 sensors.positionValid = false;真值見 truth.pos)"
        },
        "cog": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "sog": {
          "type": "number",
          "description": "kn"
        },
        "stw": {
          "type": "number",
          "description": "kn"
        },
        "depthBelowKeel": {
          "type": "number",
          "description": "m"
        },
        "headingError_deg": {
          "type": "number",
          "description": "指示航向 − 真航向(度,−180..180,右正)"
        },
        "positionError_m": {
          "type": "number",
          "minimum": 0,
          "description": "指示位置與真位置距離(m)"
        }
      }
    },
    "sensors": {
      "type": "object",
      "description": "感測器有效性(false 時對應頂層欄位為最後有效值,儀器端應標示無效/可疑;NMEA 依 IEC 61162-1 停送或標無效)與磁羅經指示;Python 不輸出",
      "required": [
        "headingValid",
        "positionValid",
        "depthValid",
        "stwValid",
        "magneticHeading"
      ],
      "properties": {
        "headingValid": {
          "type": "boolean",
          "description": "電羅經(gyroFailure 時 false)"
        },
        "positionValid": {
          "type": "boolean",
          "description": "GNSS(gpsFailure 時 false)"
        },
        "depthValid": {
          "type": "boolean",
          "description": "測深儀(echoSounderFailure 時 false)"
        },
        "stwValid": {
          "type": "boolean",
          "description": "計程儀(logFailure 無 bias/factor 參數時 false)"
        },
        "magneticHeading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "磁羅經指示(修正自差/磁差後的真航向 = 真航向 + scenario sensors.magneticCompassError_deg;不受電羅經故障影響)"
        }
      }
    },
    "autopilot": {
      "type": "object",
      "description": "自動舵狀態;自動舵以電羅經指示航向操舵(gyroDrift 時跟隨錯誤航向),autopilotFailure 或 gyroFailure 時脫開(事件 autopilotTripped)且 available = false;Python 不輸出",
      "required": [
        "enabled",
        "setHeading",
        "rotLimit_degPerMin",
        "available"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "setHeading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "設定航向(度)"
        },
        "rotLimit_degPerMin": {
          "type": "number"
        },
        "available": {
          "type": "boolean",
          "description": "可啟用(無 autopilotFailure 且 sensors.headingValid)"
        }
      }
    },
    "alerts": {
      "type": "array",
      "description": "警報清單(BAM,MSC.302(87);依 priority、raisedAt_s 排序;無警報時省略;Python 不輸出)。指令 alertAcknowledge / alertSilence 操作",
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "priority",
          "category",
          "source",
          "state",
          "text",
          "raisedAt_s",
          "escalated",
          "count",
          "audible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "警報 id:故障類 = 故障名稱(gyroFailure、gpsFailure、echoSounderFailure、logFailure、autopilotFailure、steeringGear、steeringFuOnly、steeringPumpFailure、mainEngine、bowThruster);門檻類 shallowWater、offHeading、headingMonitor;bnwas"
          },
          "number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999,
            "description": "NMEA ALR 警報編號"
          },
          "priority": {
            "type": "string",
            "enum": [
              "emergencyAlarm",
              "alarm",
              "warning",
              "caution"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "source": {
            "type": "string",
            "description": "gyro | gnss | echoSounder | log | autopilot | steering | engine | thruster | bnwas"
          },
          "state": {
            "type": "string",
            "enum": [
              "activeUnacknowledged",
              "activeSilenced",
              "activeAcknowledged",
              "rectifiedUnacknowledged"
            ]
          },
          "text": {
            "type": "string",
            "description": "顯示文字(繁體中文)"
          },
          "raisedAt_s": {
            "type": "number",
            "description": "最近一次成立的模擬時間"
          },
          "acknowledgedAt_s": {
            "type": "number"
          },
          "silencedUntil_s": {
            "type": "number",
            "description": "靜音結束時間(activeSilenced 時)"
          },
          "escalated": {
            "type": "boolean",
            "description": "曾升級(warning 未確認逾時 → alarm;BNWAS 第二階段 caution → alarm)"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "description": "成立次數"
          },
          "audible": {
            "type": "boolean",
            "description": "目前有聲響(activeUnacknowledged 且 priority 為 emergencyAlarm/alarm/warning)"
          }
        }
      }
    },
    "bnwas": {
      "type": "object",
      "description": "BNWAS(MSC.128(75))狀態;指令 bnwasMode / bnwasReset;Python 不輸出",
      "required": [
        "mode",
        "active",
        "stage",
        "dormant_s"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "on"
          ]
        },
        "active": {
          "type": "boolean",
          "description": "作動中(on,或 auto 且自動舵啟用)"
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0 休眠、1 駕駛台視覺指示、2 駕駛台聲響、3 後備值班官/船長"
        },
        "remaining_s": {
          "type": "number",
          "description": "距下一階段秒數(未作動或第三階段時省略)"
        },
        "dormant_s": {
          "type": "number",
          "minimum": 180,
          "maximum": 720
        }
      }
    },
    "tugs": {
      "type": "array",
      "description": "拖船(情境 tugs[];無拖船時省略;C# 產生,Python 不輸出;docs/design/physics-tugs-anchors-mooring.md 第 2、5 節)。力以噸力(t)、方向相對船艏順時針(度)",
      "items": {
        "type": "object",
        "required": ["id", "mode", "status", "force_t", "direction_deg"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mode": { "type": "string", "enum": ["push", "pull", "standby", "free"] },
          "status": { "type": "string", "enum": ["standby", "connecting", "repositioning", "working", "free", "parted"] },
          "force_t": { "type": "number", "minimum": 0, "description": "實際出力(t)" },
          "direction_deg": { "type": "number", "minimum": 0, "maximum": 360, "description": "實際力方向(相對船艏;0 向前、90 向右舷)" },
          "directionOrder_deg": { "type": "number", "minimum": 0, "maximum": 360 },
          "power_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "efficiency": { "type": "number", "minimum": 0, "maximum": 1, "description": "自船對水速度造成的效能" },
          "bollardPull_t": { "type": "number" },
          "lineParted": { "type": "boolean" },
          "pos": { "type": "object", "description": "示意位置(lat, lon, x, y;顯示用,非物理)" }
        }
      }
    },
    "anchors": {
      "type": "array",
      "description": "左右錨(particulars 有 anchors 資料時一律輸出;C# 產生,Python 不輸出;第 3、5 節)",
      "items": {
        "type": "object",
        "required": ["side", "status", "length_m", "tension_t", "onBottom_m"],
        "properties": {
          "side": { "type": "string", "enum": ["port", "starboard"] },
          "status": { "type": "string", "enum": ["stowed", "running", "holding", "dragging", "heaving", "aweigh"] },
          "length_m": { "type": "number", "minimum": 0, "description": "送出鏈長(m)" },
          "length_shackles": { "type": "number", "minimum": 0 },
          "maxLength_m": { "type": "number" },
          "tension_t": { "type": "number", "minimum": 0, "description": "錨鏈孔處張力(t)" },
          "horizontalTension_t": { "type": "number", "minimum": 0 },
          "onBottom_m": { "type": "number", "minimum": 0, "description": "躺底鏈長(m)" },
          "holding_t": { "type": "number", "minimum": 0, "description": "目前抓地力(錨 + 躺底鏈摩擦,t)" },
          "brake": { "type": "boolean" },
          "fullyOut": { "type": "boolean", "description": "已到鏈端" },
          "position": { "type": "object", "description": "錨位 {lat, lon, x, y}(收存時省略)" }
        }
      }
    },
    "berth": {
      "type": "object",
      "description": "泊位(情境 berth;無時省略;第 4、5 節)",
      "required": ["id", "contacts", "lines"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quayContact": { "type": "boolean", "description": "船體與碼頭面硬接觸中" },
        "contacts": {
          "type": "array",
          "description": "目前受壓的碰墊",
          "items": {
            "type": "object",
            "required": ["fenderId", "deflection_m", "reaction_kN"],
            "properties": {
              "fenderId": { "type": "string" },
              "deflection_m": { "type": "number", "minimum": 0 },
              "deflection_pct": { "type": "number", "minimum": 0 },
              "reaction_kN": { "type": "number", "minimum": 0 },
              "overload": { "type": "boolean", "description": "壓縮超過額定" }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "tension_t"],
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string", "enum": ["stowed", "fast", "heaving", "slacking", "letGo", "parted"] },
              "tension_t": { "type": "number", "minimum": 0 },
              "mbl_t": { "type": "number" },
              "bollardId": { "type": "string" },
              "length_m": { "type": "number", "description": "未受力纜長(未繫時省略)" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mmsi",
        "shipType",
        "loa",
        "beam",
        "pos",
        "heading",
        "cog",
        "sog",
        "rot",
        "range_nm",
        "bearing_deg",
        "cpa_nm",
        "tcpa_min",
        "aisOn",
        "lights",
        "behaviour"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mmsi": {
          "type": "integer"
        },
        "shipType": {
          "type": "string",
          "description": "cargo、tanker、fishing、pilot、tug、passenger、pleasure、sar、hsc、sailing、other"
        },
        "loa": {
          "type": "number",
          "description": "總長 (m)"
        },
        "beam": {
          "type": "number"
        },
        "draft": {
          "type": "number"
        },
        "pos": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "x",
            "y"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "x": {
              "type": "number",
              "description": "本地 ENU 東向 (m)"
            },
            "y": {
              "type": "number",
              "description": "本地 ENU 北向 (m)"
            }
          }
        },
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "cog": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "sog": {
          "type": "number",
          "description": "kn"
        },
        "stw": {
          "type": "number",
          "description": "對水速度 (kn)"
        },
        "rot": {
          "type": "number",
          "description": "度/分,右轉正"
        },
        "range_nm": {
          "type": "number",
          "description": "自船至目標距離 (nm)"
        },
        "bearing_deg": {
          "type": "number",
          "description": "自船看目標的真方位"
        },
        "relBearing_deg": {
          "type": "number",
          "description": "相對自船艏向 0–360"
        },
        "cpa_nm": {
          "type": "number"
        },
        "tcpa_min": {
          "type": "number",
          "description": "負值 = 已通過 CPA"
        },
        "bcr_nm": {
          "type": "number",
          "description": "艏越距離:正 = 由自船艏前通過、負 = 由艉後通過;無交會時省略"
        },
        "bct_min": {
          "type": "number",
          "description": "艏越時間(分)"
        },
        "aisOn": {
          "type": "boolean"
        },
        "lights": {
          "type": "string",
          "description": "燈號類別:powerDriven、anchored、notUnderCommand、restrictedManoeuvrability、constrainedByDraught、fishing、towing、pilot、sailing"
        },
        "sound": {
          "type": "string",
          "description": "鳴放中的聲號(oneShort、twoShort、threeShort、fiveShort、prolonged…);無時省略"
        },
        "behaviour": {
          "type": "string",
          "description": "hold、waypoints、scripted、anchored、follow、colreg;manual = 教官覆寫中"
        },
        "colreg": {
          "type": "string",
          "description": "COLREG 判定/行動,例如 crossing/giveWay/avoiding、headOn/giveWay/avoiding、crossing/standOn/holding、crossing/giveWay(ignored)、resumed"
        },
        "ais": {
          "type": "object",
          "description": "AIS 報告(ITU-R M.1371 類型 1/5 欄位;含注入錯誤)",
          "properties": {
            "mmsi": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "callSign": {
              "type": "string"
            },
            "imo": {
              "type": "integer"
            },
            "shipType": {
              "type": "integer",
              "description": "AIS 船型碼"
            },
            "navStatus": {
              "type": "integer"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "cog": {
              "type": "number"
            },
            "sog": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            },
            "rot": {
              "type": "number"
            },
            "dimToBow": {
              "type": "number"
            },
            "dimToStern": {
              "type": "number"
            },
            "dimToPort": {
              "type": "number"
            },
            "dimToStarboard": {
              "type": "number"
            },
            "draught": {
              "type": "number"
            },
            "destination": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

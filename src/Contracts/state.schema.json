{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simosa-brm/contracts/state.schema.json",
  "title": "OwnShipState",
  "description": "模擬核心每個廣播週期(25 Hz)對各站(儀器、視景、雷達、教官站、講評站)送出的自船狀態。Python 參考實作與 C# SimCore 必須產生相同欄位。角度一律以度表示、航向 0 至 360、舵角右正左負、ROT 右轉正(度/分)。",
  "type": "object",
  "required": ["t", "shipId", "pos", "heading", "cog", "sog", "stw", "rot", "u", "v", "r", "rudder", "rudderOrder", "rpm", "rpmOrder", "telegraph", "depthBelowKeel", "wind", "current", "loading", "tick"],
  "properties": {
    "t": { "type": "number", "description": "模擬時間(秒,自練習開始)" },
    "tick": { "type": "integer", "description": "核心步數(50 Hz)" },
    "shipId": { "type": "string", "enum": ["FSB1", "FSB2"] },
    "pos": { "type": "object", "required": ["lat", "lon", "x", "y"], "properties": { "lat": { "type": "number" }, "lon": { "type": "number" }, "x": { "type": "number", "description": "本地 ENU 東向 (m)" }, "y": { "type": "number", "description": "本地 ENU 北向 (m)" } } },
    "heading": { "type": "number", "minimum": 0, "maximum": 360 },
    "cog": { "type": "number", "minimum": 0, "maximum": 360 },
    "sog": { "type": "number", "description": "對地速度 (kn)" },
    "stw": { "type": "number", "description": "對水速度 (kn),縱向" },
    "rot": { "type": "number", "description": "迴轉率 (度/分),右轉正" },
    "u": { "type": "number", "description": "船體座標縱向速度 (m/s)" },
    "v": { "type": "number", "description": "船體座標橫向速度 (m/s),右正(MMG 慣例:船舯)" },
    "r": { "type": "number", "description": "艏搖角速度 (rad/s)" },
    "drift": { "type": "number", "description": "漂角 (度)" },
    "rudder": { "type": "number", "description": "實際舵角 (度)" },
    "rudderOrder": { "type": "number", "description": "舵令 (度)" },
    "rpm": { "type": "number", "description": "實際轉速,倒車負" },
    "rpmOrder": { "type": "number" },
    "telegraph": { "type": "string", "enum": ["EFAS", "FAS", "HAS", "SAS", "DSAS", "STOP", "DSAH", "SAH", "HAH", "FAH", "NAVF"] },
    "thruster": { "type": "object", "properties": { "order": { "type": "number", "minimum": -1, "maximum": 1 }, "actual": { "type": "number" } } },
    "depthBelowKeel": { "type": "number" },
    "waterDepth": { "type": "number" },
    "squat": { "type": "number" },
    "wind": { "type": "object", "required": ["trueSpeed", "trueDir"], "properties": { "trueSpeed": { "type": "number", "description": "kn" }, "trueDir": { "type": "number", "description": "來向,度" }, "relSpeed": { "type": "number" }, "relDir": { "type": "number" } } },
    "current": { "type": "object", "required": ["set", "drift"], "properties": { "set": { "type": "number", "description": "流向(去向),度" }, "drift": { "type": "number", "description": "kn" } } },
    "loading": { "type": "string", "enum": ["full", "ballast", "intermediate"] },
    "draft": { "type": "object", "properties": { "fore": { "type": "number" }, "aft": { "type": "number" } } },
    "engine": { "type": "object", "properties": { "state": { "type": "string", "enum": ["stopped", "running", "starting", "failed"] }, "startsRemaining": { "type": "integer" }, "load_pct": { "type": "number" } } },
    "faults": { "type": "array", "items": { "type": "string" } },
    "flags": { "type": "object", "properties": { "frozen": { "type": "boolean" }, "aground": { "type": "boolean" }, "collision": { "type": "boolean" } } }
  }
}
